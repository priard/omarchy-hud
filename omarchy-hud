#!/usr/bin/env python3
"""omarchy-hud: search and run the menu commands of the focused window."""

import argparse
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

__version__ = "0.1.0"

SEP = " › "
# Some connections of an app (worker threads, portals) never answer; don't wait for them.
TIMEOUT_MS = 500
GTK_MENUS = "org.gtk.Menus"
GTK_ACTIONS = "org.gtk.Actions"
DBUSMENU = "com.canonical.dbusmenu"
MOD_NAMES = {"Primary": "Ctrl", "Control": "Ctrl"}


def clean(label):
    """Strip mnemonic underscores: '_File' -> 'File', '__' -> '_'."""
    return re.sub(r"_(.)", r"\1", label)


def humanize(action):
    """'toggle-sidebar' -> 'Toggle sidebar' for actions exported without labels."""
    return action.replace("-", " ").replace("_", " ").capitalize()


def gtk_accel(accel):
    """'<Primary><Shift>s' -> 'Ctrl+Shift+S'."""
    mods = re.findall(r"<(\w+)>", accel)
    key = re.sub(r"<\w+>", "", accel)
    return "+".join([MOD_NAMES.get(m, m) for m in mods] + [key.upper() if len(key) == 1 else key])


def focused_pid():
    return json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"]))["pid"]


def pid_tree(pid):
    """The pid and all its descendants (Electron and friends talk D-Bus from children)."""
    children = {}
    for entry in os.listdir("/proc"):
        if entry.isdigit():
            try:
                with open(f"/proc/{entry}/stat") as f:
                    ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            children.setdefault(ppid, []).append(int(entry))
    tree, todo = set(), [pid]
    while todo:
        p = todo.pop()
        tree.add(p)
        todo.extend(children.get(p, []))
    return tree


class Bus:
    def __init__(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION)

    def call(self, name, path, iface, method, args=None, reply=None, timeout=TIMEOUT_MS):
        return self.conn.call_sync(
            name, path, iface, method, args,
            GLib.VariantType(reply) if reply else None,
            Gio.DBusCallFlags.NONE, timeout, None,
        ).unpack()

    def names_for(self, pids):
        (names,) = self.call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                             "org.freedesktop.DBus", "ListNames", reply="(as)")
        found = []
        for name in names:
            if not name.startswith(":"):
                continue
            try:
                (pid,) = self.call("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "GetConnectionUnixProcessID",
                                   GLib.Variant("(s)", (name,)), "(u)")
            except GLib.Error:
                continue
            if pid in pids:
                found.append(name)
        return found

    def objects(self, name, path="/"):
        """{path: set(interfaces)} for the whole object tree of a connection."""
        try:
            (xml,) = self.call(name, path, "org.freedesktop.DBus.Introspectable",
                               "Introspect", reply="(s)")
        except GLib.Error:
            return {}
        node = Gio.DBusNodeInfo.new_for_xml(xml)
        found = {path: {i.name for i in node.interfaces}}
        for child in node.nodes:
            found.update(self.objects(name, path.rstrip("/") + "/" + child.path))
        return found


def walk_gtk_menu(menus, key, path=()):
    """Flatten org.gtk.Menus groups into (label, accel, action, target)."""
    for item in menus.get(key, []):
        if ":section" in item:
            yield from walk_gtk_menu(menus, item[":section"], path)
            continue
        label = clean(item.get("label", ""))
        if ":submenu" in item:
            yield from walk_gtk_menu(menus, item[":submenu"], path + (label,))
        elif "action" in item:
            yield SEP.join(path + (label,)), item.get("accel", ""), item["action"], item.get("target")


def walk_dbusmenu(node, path=()):
    """Flatten a dbusmenu layout into (label, shortcut, id)."""
    for child in node[2]:
        item_id, props, children = child
        if not props.get("visible", True) or not props.get("enabled", True):
            continue
        if props.get("type") == "separator":
            continue
        label = clean(props.get("label", ""))
        if children:
            yield from walk_dbusmenu(child, path + (label,))
        elif label:
            shortcut = "+".join(MOD_NAMES.get(k, k) for k in props.get("shortcut", [[]])[0])
            yield SEP.join(path + (label,)), shortcut, item_id


def gtk_entries(bus, name, objects):
    """Commands from GtkApplication: menubar labels when exported, else bare action names."""
    actions = {}  # prefix -> (path, {action: (enabled, param_type, state)})
    windows = sorted((p for p, ifs in objects.items() if GTK_ACTIONS in ifs and "/window/" in p),
                     key=lambda p: int(p.rsplit("/", 1)[1]) if p.rsplit("/", 1)[1].isdigit() else 0)
    apps = [p for p, ifs in objects.items() if GTK_ACTIONS in ifs and "/window/" not in p]
    # shortcut: the first window stands for all of them, the focused one may be another (BRIEF pitfall 4)
    for prefix, paths in (("app", apps), ("win", windows)):
        if paths:
            (described,) = bus.call(name, paths[0], GTK_ACTIONS, "DescribeAll", reply="(a{s(bgav)})")
            actions[prefix] = (paths[0], described)

    def activator(prefix, action, target=None):
        path, described = actions[prefix]
        param_type = described[action][1]
        params = [GLib.Variant(param_type, target)] if param_type else []
        return lambda: bus.call(name, path, GTK_ACTIONS, "Activate",
                                GLib.Variant("(sava{sv})", (action, params, {})), timeout=-1)

    entries = []
    for path in (p for p, ifs in objects.items() if GTK_MENUS in ifs):
        menus, pending, seen = {}, {0}, set()
        while pending - seen:
            groups = sorted(pending - seen)
            seen.update(groups)
            (subscribed,) = bus.call(name, path, GTK_MENUS, "Start",
                                     GLib.Variant("(au)", (groups,)), "(a(uuaa{sv}))")
            for group, menu, items in subscribed:
                menus[(group, menu)] = items
                pending.update(it[k][0] for it in items for k in (":section", ":submenu") if k in it)
        bus.call(name, path, GTK_MENUS, "End", GLib.Variant("(au)", (sorted(seen),)))
        for label, accel, full_action, target in walk_gtk_menu(menus, (0, 0)):
            prefix, _, action = full_action.partition(".")
            described = actions.get(prefix, (None, {}))[1]
            if action in described and described[action][0]:
                if target is not None or not described[action][1]:
                    entries.append((label, gtk_accel(accel), activator(prefix, action, target)))
    if not entries:
        for prefix, (_, described) in actions.items():
            for action, (enabled, param_type, _) in sorted(described.items()):
                if enabled and not param_type:
                    entries.append((humanize(action), "", activator(prefix, action)))
    return entries


def dbusmenu_entries(bus, name, path):
    def layout():
        return bus.call(name, path, DBUSMENU, "GetLayout",
                        GLib.Variant("(iias)", (0, -1, [])), "(u(ia{sv}av))")[1]

    def submenus(node):
        for child in node[2]:
            if child[2]:
                yield child[0]
                yield from submenus(child)

    root = layout()
    # Dynamic submenus (recent files etc.) fill themselves in on AboutToShow.
    try:
        bus.call(name, path, DBUSMENU, "AboutToShowGroup",
                 GLib.Variant("(ai)", (list(submenus(root)),)))
        root = layout()
    except GLib.Error:
        pass
    return [(label, shortcut, lambda i=item_id: bus.call(
                name, path, DBUSMENU, "Event",
                GLib.Variant("(isvu)", (i, "clicked", GLib.Variant("i", 0), 0)), timeout=-1))
            for label, shortcut, item_id in walk_dbusmenu(root)]


def connection_entries(bus, name):
    objects = bus.objects(name)
    entries = []
    try:
        if any(GTK_ACTIONS in ifs or GTK_MENUS in ifs for ifs in objects.values()):
            entries += gtk_entries(bus, name, objects)
        for path in (p for p, ifs in objects.items() if DBUSMENU in ifs):
            entries += dbusmenu_entries(bus, name, path)
    except GLib.Error as e:
        print(f"omarchy-hud: {name}: {e.message}", file=sys.stderr)
    return entries


def collect(pid):
    bus = Bus()
    names = bus.names_for(pid_tree(pid))
    with ThreadPoolExecutor() as pool:
        results = pool.map(lambda n: connection_entries(bus, n), names)
    commands = {}
    for entries in results:
        for label, accel, run in entries:
            commands.setdefault(label, (accel, run))
    return commands


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pid", type=int, help="use this process instead of the focused window")
    parser.add_argument("--list", action="store_true", help="print the commands instead of showing the menu")
    parser.add_argument("--run", metavar="LABEL", help="run the command with this label without the menu")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    args = parser.parse_args()

    commands = collect(args.pid or focused_pid())
    if args.list:
        for label, (accel, _) in commands.items():
            print(f"{label}\t{accel}" if accel else label)
        return 0
    if args.run:
        label = args.run
    else:
        if not commands:
            subprocess.run(["notify-send", "omarchy-hud", "This app exports no menu commands"])
            return 1
        # A leading tab means "no icon"; the accel shows as subtext and comes back after a tab.
        rows = "\n".join(f"\t{label}\t{accel}" if accel else f"\t{label}" for label, (accel, _) in commands.items())
        picked = subprocess.run(["omarchy-menu-select", "HUD", "--", "--width", "800", "--maxheight", "500"],
                                input=rows, capture_output=True, text=True)
        if picked.returncode != 0:
            return 0
        label = picked.stdout.rstrip("\n").split("\t")[0]
    if label not in commands:
        print(f"omarchy-hud: no command {label!r}", file=sys.stderr)
        return 1
    commands[label][1]()
    return 0


if __name__ == "__main__":
    sys.exit(main())
